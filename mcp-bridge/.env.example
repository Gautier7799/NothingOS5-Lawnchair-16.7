# Copy to .env for local development and `chmod 600 .env`.
# NEVER commit a populated .env file. Every value can also be supplied through
# a `<NAME>_FILE` variable pointing at a mounted secret file.

# --- OpenHands Cloud (required) ------------------------------------------
OPENHANDS_CLOUD_API_KEY=
# OPENHANDS_CLOUD_API_KEY_FILE=/run/secrets/openhands_cloud_api_key
OPENHANDS_BASE_URL=https://app.all-hands.dev
OPENHANDS_API_PREFIX=/api/v1

# --- MCP endpoint authentication (required) -------------------------------
MCP_AUTH_TOKEN=
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token
# MCP_AUTH_TOKENS=token-one,token-two
# MCP_OAUTH_ISSUER=https://your-idp.example.com
# MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_REQUIRE_AUTH=true

# --- Transport ------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=12000
MCP_PATH=/mcp
# MCP_RESOURCE_URL=https://mcp.example.com/mcp

# --- Limits ---------------------------------------------------------------
MCP_RATE_LIMIT_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_SECONDS=60
MCP_MAX_EVENTS_RETURNED=1000
MCP_MAX_EVENT_PAGE_LIMIT=100
MCP_MAX_LIST_PAGE_LIMIT=100
MCP_MAX_TRAJECTORY_DOWNLOAD_BYTES=134217728
MCP_MAX_TRAJECTORY_EVENTS_RETURNED=500
OPENHANDS_HTTP_TIMEOUT=30
OPENHANDS_HTTP_CONNECT_TIMEOUT=10
OPENHANDS_HTTP_MAX_RETRIES=3
MCP_LOG_LEVEL=INFO
