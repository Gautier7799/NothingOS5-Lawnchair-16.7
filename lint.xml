<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!--
      Lawnchair inherits ~2500 lint errors from the upstream AOSP tree that are
      re-imported periodically by .github/workflows/import-lawnchair.yml. Pinning
      them all in a baseline would break on every import, because the import
      shifts line numbers in files we do not own.

      Instead this file silences the categories that are upstream translation
      debt (Crowdin owns the locale files, not us) and keeps every category that
      points at a real defect in code we can fix. Anything not listed here still
      fails the build via abortOnError = true.
    -->

    <!-- Locale files are generated by Crowdin; missing/extra strings are not
         actionable in a code review and account for ~800 of the upstream errors. -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="ExtraTranslation" severity="ignore" />
    <issue id="StringFormatMatches" severity="ignore" />
    <issue id="StringFormatInvalid" severity="ignore" />

    <!-- minSdk 26 with API 29/31 calls that are already guarded at the call
         sites by @RequiresApi / Build.VERSION checks, but the AOSP sources use
         their own compat annotations which this lint version does not read. -->
    <issue id="NewApi" severity="ignore" />

    <!-- Dialog window flags and other AOSP interop shims pass composite flag
         masks that lint cannot decompose. -->
    <issue id="WrongConstant" severity="ignore" />
    <issue id="ProtectedPermissions" severity="ignore" />
    <issue id="QueryAllPackagesPermission" severity="ignore" />
    <issue id="ResAuto" severity="ignore" />
</lint>
