<!--
  Music: the track title is the hero, with previous/play-pause/next controls beneath it. The
  buttons are plain vector icons so they follow the same dynamic accent as the rest of the family.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <include layout="@layout/widget_header" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_metric_text_size"
        android:textStyle="bold"
        tools:text="Song title \u00b7 Artist" />

    <LinearLayout
        android:id="@+id/widget_music_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_bar_margin_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_music_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_music_previous"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_previous"
            android:tint="@color/widget_on_surface" />

        <ImageView
            android:id="@+id/widget_music_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_music_play_pause"
            android:padding="6dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_accent" />

        <ImageView
            android:id="@+id/widget_music_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_music_next"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_next"
            android:tint="@color/widget_on_surface" />
    </LinearLayout>

    <include layout="@layout/widget_inset" />
</LinearLayout>
