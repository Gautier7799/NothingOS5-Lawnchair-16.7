<!--
  Quote/fact of the day: the text is the hero and the attribution (or the date) is the supporting
  line. Tapping the card advances to the next day's entry.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <include layout="@layout/widget_header" />

    <TextView
        android:id="@+id/widget_daily_content_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="@dimen/widget_label_text_size"
        android:textStyle="bold"
        tools:text="8 Nov" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_metric_text_size"
        tools:text="Small steps every day lead to big results." />

    <include layout="@layout/widget_inset" />
</LinearLayout>
