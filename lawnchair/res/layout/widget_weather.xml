<!--
  Weather: the reference's organic card. A generous condition icon leads, the temperature is the
  hero, and the condition plus today's range sit in the lower section. The card silhouette comes
  from `widget_weather_card*` (asymmetric corners), so this widget is not a generic rectangle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <include layout="@layout/widget_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="@dimen/widget_weather_icon_size"
            android:layout_height="@dimen/widget_weather_icon_size"
            android:contentDescription="@null"
            android:tint="@color/widget_accent"
            tools:src="@drawable/ic_weather_clear" />

        <TextView
            android:id="@+id/widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_weather_temp_text_size"
            android:textStyle="bold"
            tools:text="21\u00b0" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_inset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_inset_margin_top"
        android:background="@drawable/widget_inset_background"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/widget_inset_padding_horizontal"
        android:paddingVertical="@dimen/widget_inset_padding_vertical">

        <TextView
            android:id="@+id/widget_inset_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_inset_surface"
            android:textSize="@dimen/widget_label_text_size"
            android:textStyle="bold"
            tools:text="Partly cloudy" />

        <TextView
            android:id="@+id/widget_weather_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_inset_surface_variant"
            android:textSize="@dimen/widget_label_text_size"
            tools:text="H 24\u00b0 \u00b7 L 15\u00b0" />
    </LinearLayout>
</LinearLayout>
