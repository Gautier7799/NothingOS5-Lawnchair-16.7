<!--
  Nested tonal panel holding a widget's secondary reading. Shared by the family so the visual
  hierarchy stays consistent: hero metric on the card, supporting detail in the panel. The
  background is swapped per style in NativeWidgetPreferences.applyInset.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/widget_inset_margin_top"
    android:background="@drawable/widget_inset_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/widget_inset_padding_horizontal"
    android:paddingVertical="@dimen/widget_inset_padding_vertical">

    <TextView
        android:id="@+id/widget_inset_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_inset_surface_variant"
        android:textSize="@dimen/widget_label_text_size"
        tools:text="Discharging" />
</LinearLayout>
