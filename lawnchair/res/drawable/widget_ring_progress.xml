<!--
  Circular battery ring. Two concentric ring shapes: a faint track and an accent arc that
  grows with `level`. The ring proportions (innerRadiusRatio 3.2, thicknessRatio 5.5) give
  the slim stroke of the reference family; the arc is started at the top by rotating the
  hosting ProgressBar 270 degrees.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape
            android:shape="ring"
            android:innerRadiusRatio="3.2"
            android:thicknessRatio="5.5"
            android:useLevel="false">
            <solid android:color="@color/widget_inset_surface_outline" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate
            android:fromDegrees="270"
            android:toDegrees="270">
            <shape
                android:shape="ring"
                android:innerRadiusRatio="3.2"
                android:thicknessRatio="5.5"
                android:useLevel="true">
                <gradient
                    android:startColor="@color/widget_accent"
                    android:endColor="@color/widget_accent"
                    android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
