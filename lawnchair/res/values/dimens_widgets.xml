<resources>
    <dimen name="widget_corner_radius">24dp</dimen>
    <dimen name="widget_padding">16dp</dimen>
    <dimen name="widget_bar_margin_top">8dp</dimen>
    <!-- The time is the hero of the clock family, so it is sized well above the metric text. -->
    <dimen name="widget_clock_time_text_size">46sp</dimen>
    <dimen name="widget_clock_wide_time_text_size">54sp</dimen>
    <dimen name="widget_date_day_text_size">44sp</dimen>
    <dimen name="widget_battery_level_text_size">34sp</dimen>
    <dimen name="widget_storage_percent_text_size">30sp</dimen>
    <dimen name="widget_label_text_size">13sp</dimen>
    <dimen name="widget_preview_padding">8dp</dimen>
    <dimen name="widget_preview_icon_size">28dp</dimen>

    <!-- Header used by the redesigned widgets: a small leading icon plus a label. -->
    <dimen name="widget_header_icon_size">18dp</dimen>
    <dimen name="widget_header_margin_bottom">6dp</dimen>
    <dimen name="widget_header_gap">6dp</dimen>
    <dimen name="widget_metric_text_size">20sp</dimen>
    <dimen name="widget_progress_height">8dp</dimen>

    <!--
      Nested tonal panel used by the widget family to hold a secondary reading. Keeping one
      shared geometry is what makes the family read as a single design instead of unrelated cards.
      The radius matches the framework's `system_app_widget_inner_radius` (16 dp), which the
      reference app also adopts for its inner panel.
    -->
    <dimen name="widget_inset_radius">16dp</dimen>
    <dimen name="widget_inset_margin_top">8dp</dimen>
    <dimen name="widget_inset_padding_horizontal">12dp</dimen>
    <dimen name="widget_inset_padding_vertical">8dp</dimen>

    <!--
      Battery device: the silhouette whose fill grows with the level, plus the small terminal cap.
      The corner is tighter than the card radius so the shape reads as a device, not a card.
    -->
    <dimen name="widget_battery_corner_radius">8dp</dimen>
    <dimen name="widget_battery_device_height">30dp</dimen>
    <dimen name="widget_battery_cap_width">4dp</dimen>
    <dimen name="widget_battery_cap_height">12dp</dimen>
    <dimen name="widget_battery_inset">3dp</dimen>

    <!-- Weather hero row. -->
    <dimen name="widget_weather_icon_size">40dp</dimen>
    <dimen name="widget_weather_temp_text_size">38sp</dimen>

    <!-- Analog clock face. -->
    <dimen name="widget_analog_size">150dp</dimen>

    <!-- Hero clock: hour digits dominate, minutes sit smaller on the same baseline. -->
    <dimen name="widget_clock_hour_text_size">72sp</dimen>
    <dimen name="widget_clock_hour_min_text_size">34sp</dimen>
    <dimen name="widget_clock_minute_text_size">40sp</dimen>
    <dimen name="widget_clock_minute_min_text_size">20sp</dimen>
    <dimen name="widget_clock_minute_gap">4dp</dimen>
    <dimen name="widget_clock_period_text_size">14sp</dimen>
    <dimen name="widget_clock_period_gap">6dp</dimen>

    <!-- Pedometer: the hero count is rasterised, so its size is consumed as pixels. -->
    <dimen name="widget_steps_count_text_size">34sp</dimen>
</resources>
