<!--
  Colors for the native Lawnchair widget library.

  These deliberately alias the `system_*` palette names. Lawnchair's
  AccentColorExtractor remaps those resource ids from the current wallpaper at runtime
  (see app.lawnchair.AccentColorExtractor), so widgets that reference them follow the
  user's dynamic color instead of a hard-coded palette. The literal fallbacks used below
  come from Lawnchair's own `system_*` definitions and apply on API levels without
  Material You.
-->
<resources>
    <color name="widget_surface">@color/system_neutral1_50</color>
    <color name="widget_surface_variant">@color/system_neutral1_100</color>
    <color name="widget_surface_outline">@color/system_neutral1_200</color>
    <color name="widget_on_surface">@color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@color/system_neutral2_700</color>
    <color name="widget_accent">@color/system_accent1_500</color>
    <color name="widget_warning">@color/system_accent3_500</color>
    <color name="widget_on_accent">@color/system_accent1_0</color>

    <!-- Tonal ("accent container") card, used by the tonal style option. -->
    <color name="widget_tonal_surface">@color/system_accent1_100</color>
    <color name="widget_on_tonal_surface">@color/system_accent1_900</color>
    <color name="widget_on_tonal_surface_variant">@color/system_accent1_800</color>
    <color name="widget_tonal_outline">@color/system_accent1_200</color>

    <!-- Positive state (e.g. connected / normal temperature). -->
    <color name="widget_success">@color/system_accent2_500</color>

    <!-- Nested panel: a subtly distinct tonal surface holding a widget's secondary reading. -->
    <color name="widget_inset_surface">@color/system_neutral1_100</color>
    <color name="widget_inset_surface_outline">@color/system_neutral1_200</color>
    <color name="widget_on_inset_surface">@color/system_neutral1_900</color>
    <color name="widget_on_inset_surface_variant">@color/system_neutral2_700</color>

    <!--
      Faint neutral scrim for the transparent card style's inset. A scrim is neutral by design, so
      it only needs to track light/dark (see values-night) rather than the accent hue.
    -->
    <color name="widget_transparent_inset">#1F1A1C1E</color>

    <!--
      Roles used by the ported Material You widgets. The reference app drives these from its own
      theme attributes (`bg`, `bgOn`, `bgIcon`, `fontMain`), which it resolves to the framework
      accent palette. The same roles are aliased here so the ported layouts and drawables keep the
      reference's exact colours while still following the wallpaper through AccentColorExtractor.
    -->
    <color name="widget_m3_bg">@color/system_accent2_100</color>
    <color name="widget_m3_bg_on">@color/system_accent1_300</color>
    <color name="widget_m3_bg_icon">@color/system_accent1_700</color>
    <color name="widget_m3_font_main">@color/system_accent2_800</color>
</resources>
